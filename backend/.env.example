# Copy to .env and change every value before going live.
# Generate strong keys with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Admin account created/updated by `python seed.py` (password: 8+ characters).
# ADMIN_EMAIL receives "Forgot password" reset links.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=

# Where the website lives (used to build password reset links)
FRONTEND_URL=http://localhost:5173

# Outgoing email for password resets. Leave MAIL_SERVER empty in development:
# reset links are then printed in the Flask terminal instead.
# Gmail example: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com,
# MAIL_PASSWORD=<16-character app password>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=

# Optional settings
# DATABASE_URL=sqlite:////absolute/path/to/manna.db
# CORS_ORIGINS=http://localhost:5173,https://www.mannacollege.ac.ke
# JWT_EXPIRES_HOURS=8
# TRUST_PROXY=true            # set when running behind Nginx
# RATE_LIMIT_ENABLED=true
# FRONTEND_DIST=../frontend/dist
